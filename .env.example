# Database — app runtime connection (Neon pooled URL in prod, local Docker Postgres in dev)
DATABASE_URL=
# Direct (non-pooled) URL — only for `prisma migrate deploy` against prod
DATABASE_URL_DIRECT=
# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini # gemini | mock
# Single admin
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH= # bcrypt: node -e "console.log(require('bcryptjs').hashSync('password',10))"
SESSION_SECRET= # >=32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
